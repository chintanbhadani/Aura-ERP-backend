{
  "name": "aura-erp-backend",
  "version": "1.0.0",
  "description": "Manufacturing ERP Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:clear": "node scripts/clear-test-data.js",
    "db:clear:all": "node scripts/clear-test-data.js --all",
    "db:wipe": "node scripts/clear-test-data.js --wipe-all",
    "db:seed:company": "node scripts/seed-company.js",
    "bot:lockdown": "node scripts/telegram-lockdown-bot.js",
    "lockdown:on": "node -e \"const fs=require('fs'); fs.writeFileSync('maintenance.flag', JSON.stringify({lockedAt:new Date().toISOString(),by:'CLI'})); console.log('🔴 Maintenance Flag Created');\"",
    "lockdown:off": "node -e \"const fs=require('fs'); if(fs.existsSync('maintenance.flag')) fs.unlinkSync('maintenance.flag'); console.log('🟢 Maintenance Flag Removed');\"",
    "lockdown:status": "node -e \"const fs=require('fs'); console.log(fs.existsSync('maintenance.flag')?'🔴 LOCKED DOWN (Maintenance Active)':'🟢 ONLINE');\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "react-toastify": "^11.1.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": { 
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.19",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
